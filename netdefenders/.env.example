# NetDefenders Environment Configuration
# Copy this file to .env and fill in the values you need.

# --- AI Provider (optional) ---
# The system works fully without an API key using deterministic local analysis.
# When a key is provided, the LLM provider enhances threat reasoning/classification.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- General Configuration ---
LOG_LEVEL=INFO
LOG_FILE=netdefenders.log

# --- Orchestrator Settings ---
MAX_AGENT_RETRIES=2
